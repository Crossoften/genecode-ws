// GeneCode — schema de dados
//
// Princípio que atravessa todo este arquivo: isto é dado genético, que a LGPD
// classifica como dado pessoal sensível. Três consequências estruturais:
//
//   1. Identidade e dado genômico ficam em entidades separadas (User × Subject),
//      ligadas por vínculo explícito. Permite BI de prevalência de marcadores sem
//      tocar em identidade, e reduz a superfície de um vazamento.
//   2. Nada de laudo é sobrescrito. Interpretações e painéis são versionados, e o
//      laudo guarda a versão que usou — um laudo de 2026 precisa ser reproduzível
//      em 2030 mesmo que a base científica mude.
//   3. Consentimento e auditoria existem desde a primeira migration, não são
//      adicionados depois.
//
// Banco: MySQL 8 (a VPS já roda MySQL em Docker). Onde o Postgres usaria jsonb e
// arrays, aqui usamos Json e tabelas de junção.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// IDENTIDADE
// ============================================================================

/// Conta de acesso. Guarda quem a pessoa é — nunca o dado genético dela.
model User {
  id       String  @id @default(uuid()) @db.Char(36)
  email    String  @unique @db.VarChar(255)
  password String  @db.VarChar(255)
  name     String  @db.VarChar(160)
  document String? @unique @db.VarChar(18) // CPF ou CNPJ
  phone    String? @db.VarChar(20)

  /// Imutáveis após o cadastro — a Área do Paciente os exibe como "dados protegidos".
  birthDate     DateTime?      @db.Date
  biologicalSex BiologicalSex?

  /// Endereço de contato exibido no perfil (uma linha, derivada do CEP).
  ///
  /// Separado do endereço de entrega de propósito: o de entrega é congelado por
  /// pedido em OrderAddress; este é o cadastro vivo da pessoa.
  addressLine String? @db.VarChar(255)
  addressZip  String? @db.VarChar(9)

  status           UserStatus @default(PENDING)
  emailVerifiedAt  DateTime?
  twoFactorEnabled Boolean    @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Exclusão lógica: pedido de exclusão da LGPD não pode destruir a trilha de auditoria.
  deletedAt DateTime?

  roles             UserRole[]
  refreshTokens     RefreshToken[]
  passwordResets    PasswordReset[]
  verificationCodes VerificationCode[]
  consents          Consent[]
  auditLogs         AuditLog[]
  subjectLinks      SubjectLink[]

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  BLOCKED
}

enum BiologicalSex {
  FEMALE
  MALE
}

/// Papel. Tabela, não enum — adicionar um papel não pode exigir migração de schema.
model Role {
  id          String  @id @default(uuid()) @db.Char(36)
  slug        String  @unique @db.VarChar(64) // patient, professional, affiliate, admin, master
  name        String  @db.VarChar(120)
  description String? @db.VarChar(255)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

/// Permissão granular. Também tabela: o admin vai precisar de dezenas delas
/// (orders, kits, samples, lab, reports, products, payments, partners, audit…).
model Permission {
  id          String  @id @default(uuid()) @db.Char(36)
  slug        String  @unique @db.VarChar(64)
  name        String  @db.VarChar(120)
  description String? @db.VarChar(255)

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @db.Char(36)
  roleId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @db.Char(36)
  permissionId String     @db.Char(36)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ============================================================================
// SESSÃO E CREDENCIAIS
// ============================================================================

/// Refresh token rotativo, persistido para permitir revogação real.
///
/// O boilerplate anterior emitia JWT de 360 dias com o papel embutido — rebaixar
/// um admin não revogava nada por até um ano. Aqui o access token é curto e a
/// sessão vive nesta tabela.
model RefreshToken {
  id     String @id @default(uuid()) @db.Char(36)
  userId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 do token. O valor em claro só existe no cliente.
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  revokedAt DateTime?
  /// Rotação: aponta para o token que substituiu este. Reuso de um token já
  /// rotacionado indica roubo de sessão e derruba a cadeia inteira.
  replacedById String? @db.Char(36)

  userAgent String?  @db.VarChar(255)
  ipAddress String?  @db.VarChar(45)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Redefinição de senha por token opaco de alta entropia, hasheado e de uso único.
///
/// Substitui o código de 4 dígitos do boilerplate, cujo espaço amostral era de
/// apenas 5.040 combinações e que era consultado sem vínculo com o usuário.
model PasswordReset {
  id     String @id @default(uuid()) @db.Char(36)
  userId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_resets")
}

/// Código de 6 dígitos das telas de verificação (cadastro, troca de e-mail, 2FA).
/// Sempre vinculado ao usuário e ao propósito — nunca consultável isoladamente.
model VerificationCode {
  id     String @id @default(uuid()) @db.Char(36)
  userId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose   VerificationPurpose
  codeHash  String              @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int                 @default(0)
  createdAt DateTime            @default(now())

  @@index([userId, purpose])
  @@map("verification_codes")
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  TWO_FACTOR
  EMAIL_CHANGE
  ACCOUNT_DELETION
  BANK_DETAILS_CHANGE
}

// ============================================================================
// TITULAR DO DADO GENÉTICO
// ============================================================================

/// Titular do dado genético, separado da conta de acesso.
///
/// Existe por dois motivos. O primeiro é de negócio: o comprador pode não ser o
/// paciente — o cliente foi explícito em 01/06 de que o kit pode ser presente, e
/// que quem registra é quem coleta. O segundo é de privacidade: consultas de
/// prevalência de marcadores para o BI operam aqui sem tocar em `users`.
model Subject {
  id String @id @default(uuid()) @db.Char(36)

  /// Código único do laboratório — o mesmo impresso no kit e usado na primeira
  /// coluna do CSV de resultados. É o que liga kit → amostra → genótipo → laudo,
  /// e o cliente foi enfático sobre a razão disso existir: o DNA não pode ser
  /// atribuído à pessoa errada.
  externalCode String? @unique @db.VarChar(32)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links SubjectLink[]

  @@map("subjects")
}

/// Vínculo entre a conta e o titular do dado. Normalmente 1:1, mas modelado como
/// N:N para suportar o caso do kit presenteado e, no futuro, dependentes.
model SubjectLink {
  id        String  @id @default(uuid()) @db.Char(36)
  userId    String  @db.Char(36)
  subjectId String  @db.Char(36)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  relation  SubjectRelation @default(SELF)
  createdAt DateTime        @default(now())

  @@unique([userId, subjectId])
  @@index([subjectId])
  @@map("subject_links")
}

enum SubjectRelation {
  SELF
  DEPENDENT
  GIFTED
}

// ============================================================================
// LGPD — CONSENTIMENTO E AUDITORIA
// ============================================================================

/// Versão de um documento legal. O texto aceito precisa ser recuperável tal como
/// estava no dia do aceite — por isso o conteúdo é copiado aqui, não referenciado.
model ConsentDocument {
  id          String      @id @default(uuid()) @db.Char(36)
  type        ConsentType
  version     String      @db.VarChar(20)
  content     String      @db.LongText
  publishedAt DateTime
  createdAt   DateTime    @default(now())

  consents Consent[]

  @@unique([type, version])
  @@map("consent_documents")
}

enum ConsentType {
  TERMS_OF_USE
  PRIVACY_POLICY
  GENETIC_DATA_PROCESSING
  DATA_SHARING_PROFESSIONAL
  PARTNER_PROGRAM
  MARKETING
}

/// Aceite ou revogação, com data, hora e IP. Nunca sofre UPDATE: revogar cria um
/// novo registro com `revokedAt`, preservando a linha do tempo.
model Consent {
  id         String          @id @default(uuid()) @db.Char(36)
  userId     String          @db.Char(36)
  documentId String          @db.Char(36)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   ConsentDocument @relation(fields: [documentId], references: [id])

  grantedAt DateTime  @default(now())
  revokedAt DateTime?
  ipAddress String?   @db.VarChar(45)
  userAgent String?   @db.VarChar(255)

  @@index([userId])
  @@index([documentId])
  @@map("consents")
}

/// Trilha de auditoria. Quem acessou qual laudo, quando e em que papel.
/// Append-only: não existe caso de uso legítimo para editar ou apagar uma linha.
model AuditLog {
  id     String  @id @default(uuid()) @db.Char(36)
  userId String? @db.Char(36)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String  @db.VarChar(80) // report.viewed, sharing.revoked, csv.uploaded…
  resource   String  @db.VarChar(80) // report, sample, subject…
  resourceId String? @db.Char(36)
  /// Contexto adicional. Em MySQL é JSON; para filtrar por uma chave específica,
  /// criar coluna gerada + índice secundário na migration.
  metadata   Json?

  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// GENOMICS — catálogo de marcadores e painéis
// ============================================================================
//
// O ponto central deste bloco: **escore e interpretação pertencem ao painel**,
// não ao SNP. Parece redundante — o mesmo rs4880 aparece nos dois painéis — mas
// a análise das fontes mostrou que o SOD2 rs4880 tem polaridade INVERTIDA entre
// performance e nutrigenética (TT favorável num, desfavorável no outro), e o
// ADRB3 rs4994 diverge entre as fontes do mesmo painel.
//
// Modelar o escore como propriedade do SNP obrigaria a escolher um lado
// silenciosamente. Modelando por painel, a divergência fica explícita no dado e
// pode ser sinalizada no laudo Premium até o Dr. Câmara arbitrar.

/// Marcador genético. Identificado pelo rsID, nunca pelo nome do gene — a
/// análise encontrou o mesmo marcador nomeado `TNF_rs1800629` numa fonte e
/// `TNF-alfa_rs1800629` noutra, o que quebrava o cruzamento.
model Snp {
  id       String  @id @default(uuid()) @db.Char(36)
  rsId     String  @unique @db.VarChar(32) // rs1815739
  gene     String  @db.VarChar(32) // ACTN3 — rótulo de exibição
  fullName String? @db.VarChar(160)

  /// Frequência do alelo menor na população (GnomAD), para exibição no laudo.
  minorAllele     String? @db.VarChar(8)
  minorAlleleFreq Decimal? @db.Decimal(8, 6)
  majorAllele     String? @db.VarChar(8)
  majorAlleleFreq Decimal? @db.Decimal(8, 6)

  /// Texto "ação da proteína": explica o gene e é idêntico para os 3 genótipos.
  proteinAction String? @db.LongText

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  panelSnps      PanelSnp[]
  subjectResults SubjectGenotype[]

  @@index([gene])
  @@map("snps")
}

// ============================================================================
// PAINEL VERSIONADO
// ============================================================================

/// Painel de análise, versionado e imutável depois de publicado.
///
/// Um laudo emitido precisa ser reproduzível anos depois. Se um peso for
/// corrigido em 2027, os laudos de 2026 não podem mudar retroativamente — isso
/// seria adulterar documento de saúde. Por isso não se faz UPDATE em painel
/// publicado: publica-se uma nova versão, e cada laudo guarda a que usou.
model Panel {
  id      String      @id @default(uuid()) @db.Char(36)
  slug    String      @db.VarChar(64) // performance, nutrigenetics
  version String      @db.VarChar(20) // 1.0.0
  name    String      @db.VarChar(160)
  kind    PanelKind
  /// Modelo matemático de combinação genético × ambiental.
  scoringModel ScoringModel

  status      PanelStatus @default(DRAFT)
  publishedAt DateTime?
  notes       String?     @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories     PanelCategory[]
  snps           PanelSnp[]
  modalities     Modality[]
  interpretations Interpretation[]
  composites      PanelComposite[]
  reports        Report[]

  @@unique([slug, version])
  @@index([status])
  @@map("panels")
}

enum PanelKind {
  PERFORMANCE
  NUTRIGENETICS
}

enum PanelStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Como o escore ambiental se combina com o genético.
///
/// ADDITIVE      — performance: Ajustado = Genético×0,30 + Ambiental×0,70
/// MULTIPLICATIVE — nutrigenética: Ajustado = Bruto × Modificador (0,6–1,4)
enum ScoringModel {
  ADDITIVE
  MULTIPLICATIVE
}

/// Categoria biológica dentro de um painel (Força e Potência, Metabolismo…).
model PanelCategory {
  id      String @id @default(uuid()) @db.Char(36)
  panelId String @db.Char(36)
  panel   Panel  @relation(fields: [panelId], references: [id], onDelete: Cascade)

  slug     String @db.VarChar(64) // forca_potencia
  name     String @db.VarChar(120)
  position Int    @default(0)

  snps            PanelSnp[]
  composites      PanelComposite[]
  modalityWeights ModalityWeight[]
  percentiles     PercentilePoint[]
  reportScores    ReportCategoryScore[]

  @@unique([panelId, slug])
  @@map("panel_categories")
}

/// Vínculo SNP × painel, com o peso dele dentro da categoria.
model PanelSnp {
  id         String        @id @default(uuid()) @db.Char(36)
  panelId    String        @db.Char(36)
  snpId      String        @db.Char(36)
  categoryId String        @db.Char(36)
  panel      Panel         @relation(fields: [panelId], references: [id], onDelete: Cascade)
  snp        Snp           @relation(fields: [snpId], references: [id])
  category   PanelCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Peso dentro da categoria. Normalizado na leitura, então não precisa somar 1.
  weight   Decimal @db.Decimal(6, 4)
  position Int     @default(0)

  genotypeScores GenotypeScore[]

  @@unique([panelId, snpId])
  @@index([categoryId])
  @@map("panel_snps")
}

/// Escore de um genótipo dentro de um painel.
///
/// A escala é variável por SNP (0/50/100, 20/60/100, 30/65/100…), não uniforme
/// como a especificação em markdown afirmava — o mockup de referência e o código
/// Python concordam entre si contra o texto da spec.
model GenotypeScore {
  id         String   @id @default(uuid()) @db.Char(36)
  panelSnpId String   @db.Char(36)
  panelSnp   PanelSnp @relation(fields: [panelSnpId], references: [id], onDelete: Cascade)

  genotype       String         @db.VarChar(24) // forma canônica
  score          Decimal        @db.Decimal(6, 2)
  classification Classification

  @@unique([panelSnpId, genotype])
  @@map("genotype_scores")
}

enum Classification {
  FAVORAVEL
  MODERADO
  DESFAVORAVEL
}

// ============================================================================
// ÍNDICES COMPOSTOS
// ============================================================================

/// Índice composto: o Global e as 30 modalidades esportivas.
model Modality {
  id      String @id @default(uuid()) @db.Char(36)
  panelId String @db.Char(36)
  panel   Panel  @relation(fields: [panelId], references: [id], onDelete: Cascade)

  slug      String  @db.VarChar(64) // global, futebol, e_sports
  name      String  @db.VarChar(120)
  /// O índice Global é o número de capa do laudo; os demais são por esporte.
  isGlobal  Boolean @default(false)
  position  Int     @default(0)

  weights     ModalityWeight[]
  percentiles PercentilePoint[]
  reportIndexes ReportModalityIndex[]

  @@unique([panelId, slug])
  @@map("modalities")
}

/// Peso de cada categoria biológica dentro de uma modalidade.
model ModalityWeight {
  id         String        @id @default(uuid()) @db.Char(36)
  modalityId String        @db.Char(36)
  categoryId String        @db.Char(36)
  modality   Modality      @relation(fields: [modalityId], references: [id], onDelete: Cascade)
  category   PanelCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  weight Decimal @db.Decimal(6, 4)

  @@unique([modalityId, categoryId])
  @@map("modality_weights")
}

/// Ponto da curva de percentil populacional, para a normalização 20–90.
///
/// Existe por categoria (curva analítica via Hardy-Weinberg sobre frequências do
/// GnomAD) e por modalidade (curva por Monte Carlo, porque as 6 categorias são
/// correlacionadas e a composição não tem forma fechada).
///
/// A normalização das modalidades corrige a compressão do Índice Global: sem
/// ela, metade da população cai numa faixa de 12 pontos e o laudo parece dizer
/// que ninguém tira nota alta.
model PercentilePoint {
  id         String  @id @default(uuid()) @db.Char(36)
  categoryId String? @db.Char(36)
  modalityId String? @db.Char(36)
  category   PanelCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  modality   Modality?      @relation(fields: [modalityId], references: [id], onDelete: Cascade)

  rawScore   Decimal @db.Decimal(8, 4)
  percentile Decimal @db.Decimal(8, 4)

  @@index([categoryId, rawScore])
  @@index([modalityId, rawScore])
  @@map("percentile_points")
}

// ============================================================================
// CONTEÚDO DO LAUDO
// ============================================================================

/// Texto interpretativo por genótipo, versionado junto do painel.
///
/// Escopo por painel pelo mesmo motivo do GenotypeScore: onde a polaridade
/// diverge, o texto que o paciente lê diverge junto.
model Interpretation {
  id      String @id @default(uuid()) @db.Char(36)
  panelId String @db.Char(36)
  panel   Panel  @relation(fields: [panelId], references: [id], onDelete: Cascade)

  rsId     String @db.VarChar(32)
  genotype String @db.VarChar(24)

  /// Frequência populacional deste genótipo, para contexto no laudo.
  genotypeFreq Decimal? @db.Decimal(10, 8)
  /// Resumo clínico curto.
  summary String? @db.Text
  /// Texto voltado ao paciente — cerca de mil caracteres.
  patientText String @db.LongText
  /// Referências científicas do genótipo específico.
  references String? @db.LongText

  /// Marca texto cuja polaridade contradiz o escore adotado.
  ///
  /// O ADRB3 rs4994 tinha classificação invertida entre as fontes. A decisão
  /// B5-bis adotou a do Python (TT favorável), mas os textos vieram do mockup,
  /// escritos para a polaridade contrária. Enquanto o Dr. Câmara não reescrever,
  /// o laudo omite o texto e mostra um aviso — melhor não dizer nada do que
  /// dizer ao paciente o oposto do que o escore dele indica.
  reviewRequired Boolean @default(false)
  reviewNote     String? @db.VarChar(500)

  @@unique([panelId, rsId, genotype])
  @@map("interpretations")
}

// ============================================================================
// DADOS DO TITULAR E LAUDO
// ============================================================================

/// Lote de genótipos enviado pelo laboratório via CSV.
model GenotypeBatch {
  id           String      @id @default(uuid()) @db.Char(36)
  filename     String      @db.VarChar(255)
  uploadedById String?     @db.Char(36)
  status       BatchStatus @default(PENDING)

  rowCount     Int    @default(0)
  processedCount Int  @default(0)
  failedCount  Int    @default(0)
  /// Erros por linha, para o admin corrigir o arquivo e reenviar.
  errors       Json?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  genotypes SubjectGenotype[]

  @@index([status])
  @@map("genotype_batches")
}

enum BatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Genótipo observado de um titular para um marcador.
///
/// Guarda o valor bruto ao lado do canônico: quando um laudo for contestado,
/// é preciso poder mostrar exatamente o que o laboratório enviou.
model SubjectGenotype {
  id        String @id @default(uuid()) @db.Char(36)
  subjectId String @db.Char(36)
  snpId     String @db.Char(36)
  snp       Snp    @relation(fields: [snpId], references: [id])

  /// Valor como veio no CSV.
  rawValue String @db.VarChar(24)
  /// Valor após normalização de fita e notação.
  genotype String @db.VarChar(24)

  batchId String?        @db.Char(36)
  batch   GenotypeBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([subjectId, snpId])
  @@index([snpId])
  @@map("subject_genotypes")
}

/// Laudo calculado. Imutável: recalcular gera uma nova versão.
model Report {
  id        String @id @default(uuid()) @db.Char(36)
  subjectId String @db.Char(36)
  panelId   String @db.Char(36)
  /// Versão do painel usada — é o que torna o laudo reproduzível no futuro.
  panel     Panel  @relation(fields: [panelId], references: [id])

  version   Int          @default(1)
  status    ReportStatus @default(DRAFT)
  /// Marcadores que faltaram no CSV, se houver. Some no laudo como aviso.
  missingMarkers Json?

  /// Texto de recomendação, gerado uma vez na emissão (decisão L4).
  ///
  /// Persistido porque laudo de saúde precisa ser reproduzível: gerar a cada
  /// abertura faria o mesmo laudo dizer coisas diferentes em dias diferentes.
  /// Guarda junto o provedor, o modelo e a versão do prompt — sem isso não há
  /// como, daqui a um ano, saber sob quais instruções aquele texto nasceu.
  narrative Json?

  computedAt   DateTime  @default(now())
  publishedAt  DateTime?

  categoryScores  ReportCategoryScore[]
  modalityIndexes ReportModalityIndex[]

  @@unique([subjectId, panelId, version])
  @@index([status])
  @@map("reports")
}

enum ReportStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

/// Escore de uma categoria biológica no laudo.
model ReportCategoryScore {
  id         String        @id @default(uuid()) @db.Char(36)
  reportId   String        @db.Char(36)
  categoryId String        @db.Char(36)
  report     Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  category   PanelCategory @relation(fields: [categoryId], references: [id])

  /// Soma ponderada dos SNPs, antes da normalização.
  rawScore Decimal @db.Decimal(8, 4)
  /// Após percentil populacional — a escala 20–90 que o paciente vê.
  normalizedScore Decimal @db.Decimal(6, 2)
  band            ScoreBand

  @@unique([reportId, categoryId])
  @@map("report_category_scores")
}

/// Índice composto no laudo (Global ou por modalidade).
model ReportModalityIndex {
  id         String   @id @default(uuid()) @db.Char(36)
  reportId   String   @db.Char(36)
  modalityId String   @db.Char(36)
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  modality   Modality @relation(fields: [modalityId], references: [id])

  rawIndex        Decimal   @db.Decimal(8, 4)
  normalizedIndex Decimal   @db.Decimal(6, 2)
  band            ScoreBand

  @@unique([reportId, modalityId])
  @@map("report_modality_indexes")
}

/// Faixa de classificação, ancorada nos quartis da normalização populacional.
///
/// Como score = 20 + percentil × 0,70, os quartis caem exatamente em
/// 37,5 / 55 / 72,5. As faixas antigas (0–34 e 80–100) tinham trechos
/// inalcançáveis, já que nenhum escore sai da faixa 20–90.
enum ScoreBand {
  FAVORAVEL   // 73–90 · quartil superior
  MODERADO    // 55–72 · acima da mediana
  ATENCAO     // 38–54 · abaixo da mediana
  PRIORIDADE  // 20–37 · quartil inferior
}

// ============================================================================
// CATÁLOGO
// ============================================================================

/// Produto da vitrine.
///
/// Parametrizável desde o início: o Dr. Câmara disse em 28/05 que começam com
/// dois produtos e "logo alguns meses vai passar para três", e Augusto pediu
/// explicitamente que escale para quantos o portfólio crescer. Cadastrar um
/// produto novo não pode exigir deploy.
model Product {
  id    String @id @default(uuid()) @db.Char(36)
  slug  String @unique @db.VarChar(80)
  name  String @db.VarChar(160)

  /// Resumo do card da vitrine — o protótipo limita a 160 caracteres.
  summary     String @db.VarChar(200)
  description String @db.Text

  /// Painel genético que este produto entrega. Nulo enquanto o painel não
  /// existir — é o caso do Premium até os marcadores compostos entrarem.
  panelSlug String? @db.VarChar(64)

  /// Quantidade de marcadores anunciada.
  ///
  /// Fica no banco, e não derivada do painel, por uma razão desconfortável: a
  /// vitrine aprovada anuncia 45/52/120+ e os painéis entregam 30/24/44. Manter
  /// o número explícito torna a divergência visível e auditável em vez de
  /// escondê-la atrás de um COUNT que ninguém confere.
  markerCount Int

  priceCents Int
  /// Preço promocional, quando houver.
  promoPriceCents Int?
  /// Parcelas sem juros oferecidas no checkout.
  maxInstallments Int @default(12)

  /// Publicar é passo intencional: todo produto novo nasce despublicado.
  published Boolean @default(false)
  /// Arquivado sai da vitrine mas permanece no banco — há clientes que
  /// compraram, e o histórico precisa continuar íntegro.
  archived  Boolean @default(false)

  /// Destaque do card ("Mais vendido").
  highlight String? @db.VarChar(40)
  position  Int     @default(0)

  imageUrl String? @db.VarChar(500)

  /// Dados físicos do kit, exibidos e editados no admin (tela adm-8).
  weightGrams  Int?
  dimensionsCm String? @db.VarChar(20)
  category     String? @db.VarChar(40)

  /// Itens do "o que está incluso", um por posição.
  features ProductFeature[]
  /// Eixos usados pelo quiz de recomendação.
  traits   ProductTrait[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, archived])
  @@map("products")
}

model ProductFeature {
  id        String  @id @default(uuid()) @db.Char(36)
  productId String  @db.Char(36)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// 300, não 200: o item de acompanhamentos de performance que o cliente
  /// mandou em 09/09 tem 209 caracteres, e o André decidiu no mesmo dia
  /// (item 27) mantê-lo como UM item só na lista, sem quebrar em vários.
  label    String @db.VarChar(300)
  position Int    @default(0)

  @@index([productId])
  @@map("product_features")
}

/// Aderência de um produto a um eixo do quiz.
///
/// O quiz precisa recomendar sem que a regra viva em código: Augusto foi
/// categórico em 15/06 de que ele **sempre** indica algum produto —
/// *"não pode assim, 'ah, para você não serve nenhum'"*. Pontuar por eixo e
/// escolher o maior garante isso por construção.
model ProductTrait {
  id        String  @id @default(uuid()) @db.Char(36)
  productId String  @db.Char(36)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Eixo: nutrition, performance, health.
  trait  String @db.VarChar(40)
  /// Peso de 0 a 100.
  weight Int

  @@unique([productId, trait])
  @@map("product_traits")
}

/// Marcador composto dentro de uma categoria.
///
/// MTHFR e HFE são dois SNPs cada que só têm significado clínico juntos: o
/// efeito não é a soma das partes, há interação, e a fórmula do laboratório
/// aplica penalidade explícita ao heterozigoto composto.
///
/// A tabela guarda só a referência à regra e o peso — a matemática vive em
/// `domain/scoring/composite-marker.ts`, onde pode ser lida e conferida contra
/// a literatura.
model PanelComposite {
  id         String        @id @default(uuid()) @db.Char(36)
  panelId    String        @db.Char(36)
  categoryId String        @db.Char(36)
  panel      Panel         @relation(fields: [panelId], references: [id], onDelete: Cascade)
  category   PanelCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Chave da regra no domínio: `mthfr` ou `hfe`.
  ruleKey  String  @db.VarChar(40)
  name     String  @db.VarChar(120)
  weight   Decimal @db.Decimal(6, 4)
  position Int     @default(0)

  @@unique([panelId, ruleKey])
  @@index([categoryId])
  @@map("panel_composites")
}

// ============================================================================
// COMÉRCIO
// ============================================================================

/// Pedido.
///
/// `customer` é quem comprou e pagou; o titular do dado genético é resolvido só
/// na ativação do kit. O cliente foi explícito em 01/06: o kit pode ser
/// presente, e quem registra é quem coleta. Amarrar pedido e paciente aqui
/// impediria o caso de uso que ele mais destacou.
model Order {
  id     String @id @default(uuid()) @db.Char(36)
  /// Número visível ao cliente, no formato GC-AAAA-NNNNN.
  number String @unique @db.VarChar(20)

  /// Conta que fez a compra. Nulo enquanto o checkout é anônimo — a conta é
  /// oferecida depois da confirmação, como o cliente definiu em 28/05.
  userId String? @db.Char(36)

  /// Dados de quem comprou, congelados no momento do pedido.
  customerName  String @db.VarChar(160)
  customerEmail String @db.VarChar(255)
  customerDoc   String @db.VarChar(18)
  customerPhone String? @db.VarChar(20)

  status OrderStatus @default(PENDING_PAYMENT)

  /// Valores em centavos. Dinheiro em ponto flutuante acumula erro, e o split
  /// de comissão depende de aritmética exata.
  subtotalCents Int
  discountCents Int @default(0)
  shippingCents Int @default(0)
  totalCents    Int

  couponCode String? @db.VarChar(40)
  /// Percentual de comissão vigente no momento do pedido, congelado.
  /// Alterar a comissão de um parceiro não pode reprecificar vendas passadas.
  commissionRate Decimal? @db.Decimal(5, 2)
  commissionCents Int?

  shippingMethod String? @db.VarChar(40)
  /// Rastreio da ida: laboratório → casa do cliente.
  outboundTracking String? @db.VarChar(60)
  /// Rastreio da volta: cliente → laboratório.
  inboundTracking  String? @db.VarChar(60)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  address    OrderAddress?
  items      OrderItem[]
  payments   Payment[]
  events     OrderEvent[]

  @@index([status])
  @@index([userId])
  @@index([customerEmail])
  @@map("orders")
}

/// Estados do pedido.
///
/// Uma máquina de estados só, resolvendo os três vocabulários divergentes que a
/// análise encontrou entre os protótipos de Paciente, Admin e Genoa.
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  KIT_SHIPPED
  KIT_DELIVERED
  SAMPLE_IN_TRANSIT
  SAMPLE_RECEIVED
  PROCESSING
  REPORT_READY
  CANCELLED
  REFUNDED
}

/// Item do pedido, com preço congelado.
///
/// Nome e preço são copiados, não referenciados: mudar o preço do produto no
/// admin não pode alterar o valor de um pedido já feito.
model OrderItem {
  id      String @id @default(uuid()) @db.Char(36)
  orderId String @db.Char(36)
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productSlug String @db.VarChar(80)
  productName String @db.VarChar(160)
  unitCents   Int
  quantity    Int    @default(1)

  @@index([orderId])
  @@map("order_items")
}

/// Endereço de entrega, congelado no pedido.
model OrderAddress {
  id      String @id @default(uuid()) @db.Char(36)
  orderId String @unique @db.Char(36)
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  zipCode      String  @db.VarChar(9)
  street       String  @db.VarChar(200)
  number       String  @db.VarChar(20)
  complement   String? @db.VarChar(100)
  neighborhood String  @db.VarChar(120)
  city         String  @db.VarChar(120)
  state        String  @db.VarChar(2)

  @@map("order_addresses")
}

/// Tentativa de pagamento.
///
/// Um pedido pode ter várias: cartão recusado, cliente tenta Pix. Guardar todas
/// é o que permite ao admin entender por que uma venda não fechou.
model Payment {
  id      String @id @default(uuid()) @db.Char(36)
  orderId String @db.Char(36)
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amountCents Int

  /// Identificador na adquirente. Nulo até ela responder.
  externalId String? @db.VarChar(120)
  /// Motivo da recusa, quando houver.
  failureReason String? @db.VarChar(255)
  installments  Int     @default(1)

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@index([orderId])
  @@index([externalId])
  @@map("payments")
}

enum PaymentMethod {
  CREDIT_CARD
  PIX
  BOLETO
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  REFUSED
  REFUNDED
  EXPIRED
}

/// Evento na linha do tempo do pedido.
///
/// Append-only. É o que alimenta o acompanhamento do cliente e a esteira de SLA
/// do admin — que o cliente descreveu como "onde está o pênalti do negócio".
model OrderEvent {
  id      String @id @default(uuid()) @db.Char(36)
  orderId String @db.Char(36)
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status    OrderStatus
  note      String?  @db.VarChar(500)
  /// Quem provocou: `system`, ou o id do admin.
  actor     String?  @db.VarChar(80)
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_events")
}

/// Cupom de desconto, que é também o vínculo com o parceiro.
model Coupon {
  id   String @id @default(uuid()) @db.Char(36)
  code String @unique @db.VarChar(40)

  /// Desconto ao cliente, em pontos percentuais.
  discountPercent Decimal @db.Decimal(5, 2)
  /// Comissão do parceiro. Variável por parceiro, definida no admin.
  commissionPercent Decimal @db.Decimal(5, 2)

  partnerName String? @db.VarChar(160)
  active      Boolean @default(true)
  expiresAt   DateTime?
  /// Limite de usos. Nulo é ilimitado.
  maxUses  Int?
  usedCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@map("coupons")
}

// ============================================================================
// LABORATÓRIO — KITS E AMOSTRAS
// ============================================================================

/// Lote de kits, para impressão e rastreio de produção.
model KitBatch {
  id        String   @id @default(uuid()) @db.Char(36)
  reference String   @unique @db.VarChar(40)
  notes     String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  kits Kit[]

  @@map("kit_batches")
}

/// Kit físico, identificado pelo código de ativação impresso nele.
///
/// O código é a chave que atravessa o sistema inteiro: está na etiqueta dentro
/// da caixa, é digitado na ativação, e é a primeira coluna do CSV de resultados
/// que o laboratório envia. A decisão F2 unificou os dois códigos que o
/// protótipo tinha num só, porque kit e exame andam juntos.
model Kit {
  id   String @id @default(uuid()) @db.Char(36)
  /// Formato XXXXXX-XX, com dígitos verificadores módulo 11.
  code String @unique @db.VarChar(12)

  batchId String   @db.Char(36)
  batch   KitBatch @relation(fields: [batchId], references: [id])

  status KitStatus @default(GENERATED)

  /// Pedido a que o kit foi atribuído no despacho.
  orderId String? @db.Char(36)
  /// Titular do dado genético, definido na ativação.
  ///
  /// Separado do pedido de propósito: o comprador pode não ser o paciente. O
  /// cliente foi enfático em 01/06 sobre o kit poder ser presente, e sobre o
  /// registro ser feito por quem coleta — *"DNA tem que ser exatamente para a
  /// pessoa que está adquirindo aquele kit"*.
  subjectId String? @db.Char(36)
  /// Conta que ativou o kit.
  activatedByUserId String? @db.Char(36)

  activatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([orderId])
  @@map("kits")
}

enum KitStatus {
  /// Gerado e impresso, ainda no estoque.
  GENERATED
  /// Atribuído a um pedido e despachado.
  ASSIGNED
  /// Ativado pelo cliente, com titular definido.
  ACTIVATED
  /// Amostra coletada e enviada ao laboratório.
  SAMPLE_SENT
  /// Amostra recebida no laboratório.
  SAMPLE_RECEIVED
  /// Descartado: extraviado, danificado ou coleta inviável.
  DISCARDED
}

// ============================================================================
// ACOMPANHAMENTO PROFISSIONAL
// ============================================================================

/// Perfil profissional: personal trainer, nutricionista, médico.
///
/// Cadastro **livre**, com autodeclaração de especialidade e sem validação de
/// conselho de classe. Foi decisão explícita do cliente em 16/07 — o Dr. Câmara
/// chamou de "princípio do consulado americano", e André argumentou que barreira
/// de entrada reduz a base: *"quanto mais a gente bloqueia pessoas de entrar,
/// menos público-alvo a gente tem"*.
///
/// O caso de uso que justifica: o ex-atleta que treina corrida sem ser formado
/// em educação física.
model ProfessionalProfile {
  id     String @id @default(uuid()) @db.Char(36)
  userId String @unique @db.Char(36)

  /// Autodeclarada, de uma lista fechada.
  specialty String  @db.VarChar(60)
  /// Registro de conselho, se a pessoa tiver. Não é validado nem obrigatório.
  councilId String? @db.VarChar(40)
  bio       String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shares      DataSharing[]
  assessments Assessment[]

  @@map("professional_profiles")
}

/// Autorização de acesso ao laudo consolidado.
///
/// Os dois sentidos são suportados (decisão F1): o profissional solicita e o
/// paciente autoriza, ou o paciente autoriza direto. A diferença é só quem cria
/// o registro e se ele nasce pendente.
model DataSharing {
  id             String              @id @default(uuid()) @db.Char(36)
  subjectId      String              @db.Char(36)
  professionalId String              @db.Char(36)
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  status      SharingStatus @default(PENDING)
  initiatedBy SharingInitiator

  /// Termo de consentimento aceito, com a versão exata.
  consentDocumentId String? @db.Char(36)

  requestedAt  DateTime  @default(now())
  authorizedAt DateTime?
  revokedAt    DateTime?
  ipAddress    String?   @db.VarChar(45)

  @@unique([subjectId, professionalId])
  @@index([professionalId, status])
  @@map("data_sharings")
}

enum SharingStatus {
  PENDING
  AUTHORIZED
  REVOKED
}

enum SharingInitiator {
  PATIENT
  PROFESSIONAL
}

/// Entrevista ambiental conduzida pelo profissional.
///
/// Imutável depois de concluída. O Dr. Câmara foi categórico em 16/07:
/// *"Uma vez feito o primeiro, aquilo ali tá bloqueado. Não dá para ir em outro:
/// 'ah, faz aí agora que agora eu aprendi a responder melhor'."*
model Assessment {
  id             String              @id @default(uuid()) @db.Char(36)
  subjectId      String              @db.Char(36)
  professionalId String              @db.Char(36)
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])

  /// Q0 a Q4, sequenciais e espaçados por 3 meses.
  checkpoint Checkpoint

  /// Respostas: questionId → índice da opção escolhida.
  answers Json
  /// Escore ambiental por categoria, calculado na conclusão.
  environmentalScores Json?
  /// Escore ajustado por categoria, combinando genético e ambiental.
  adjustedScores Json?

  completedAt DateTime @default(now())

  @@unique([subjectId, checkpoint])
  @@index([professionalId])
  @@map("assessments")
}

enum Checkpoint {
  Q0
  Q1
  Q2
  Q3
  Q4
}

// ============================================================================
// PARCEIROS
// ============================================================================

/// Parceiro afiliado: vende por cupom e recebe comissão.
///
/// Distinto do parceiro **profissional**, que atende pacientes. Augusto separou
/// os dois em 15/06 com um exemplo claro: *"uma recepcionista da academia pode
/// vender esse produto, mas ela não vai orientar você porque ela é uma
/// recepcionista"*. Os papéis se sobrepõem — o personal pode vender e orientar —
/// mas são cadastros e permissões diferentes.
model Partner {
  id     String @id @default(uuid()) @db.Char(36)
  userId String @unique @db.Char(36)

  type PartnerType

  displayName String  @db.VarChar(160)
  document    String  @db.VarChar(18)
  /// Como divulga: Instagram, site, consultório.
  channel     String? @db.VarChar(200)

  /// Cupom exclusivo, gerado no cadastro.
  couponCode String @unique @db.VarChar(40)

  /// Dados de repasse.
  pixKeyType String? @db.VarChar(20)
  pixKey     String? @db.VarChar(140)
  bankName   String? @db.VarChar(80)
  bankBranch String? @db.VarChar(20)
  bankAccount String? @db.VarChar(30)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payouts Payout[]

  @@index([active])
  @@map("partners")
}

enum PartnerType {
  INDIVIDUAL
  COMPANY
}

/// Repasse de comissão ao parceiro.
///
/// O split acontece na adquirente no ato da venda, mas o registro aqui é o que
/// permite ao parceiro conferir o que entrou e ao admin fechar o mês. O cliente
/// pediu no painel: quanto vendeu, quanto converteu, previsibilidade do mês.
model Payout {
  id        String  @id @default(uuid()) @db.Char(36)
  partnerId String  @db.Char(36)
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  orderId     String @db.Char(36)
  orderNumber String @db.VarChar(20)

  amountCents Int
  status      PayoutStatus @default(PENDING)

  /// Identificador da transferência na adquirente.
  externalId String?   @db.VarChar(120)
  settledAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([orderId])
  @@index([partnerId, status])
  @@map("payouts")
}

enum PayoutStatus {
  /// Venda registrada, repasse ainda não liberado.
  PENDING
  /// Em processamento na adquirente.
  PROCESSING
  /// Repassado.
  SETTLED
  /// Estornado junto com o pedido.
  REVERSED
}

/// Gatilho de mensagem automática ao paciente por etapa do exame (adm-10).
///
/// Configuração viva editada pelo admin — texto-modelo com placeholders
/// literais ({nome}, {pedido}, {link_rastreio}, {link_laudo}), canais e
/// liga/desliga. O disparo real passa pela porta NotificationSender; enquanto
/// a operadora não é contratada, o sender de log registra em NotificationLog.
model NotificationTrigger {
  id  String @id @default(uuid()) @db.Char(36)
  key NotificationTriggerKey @unique

  enabled  Boolean @default(true)
  /// Texto-modelo com placeholders literais, emojis inclusos.
  template String  @db.Text

  channelWhatsapp Boolean @default(true)
  channelEmail    Boolean @default(true)
  channelSms      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_triggers")
}

enum NotificationTriggerKey {
  ORDER_CONFIRMED
  KIT_SHIPPED
  SAMPLE_RECEIVED
  REMINDER
  REPORT_READY
}

/// Registro de cada envio (ou tentativa) — alimenta os KPIs de mensageria.
model NotificationLog {
  id         String  @id @default(uuid()) @db.Char(36)
  triggerKey NotificationTriggerKey
  channel    NotificationChannel
  /// E-mail ou telefone, como enviado.
  recipient  String  @db.VarChar(255)
  orderId    String? @db.Char(36)
  status     NotificationLogStatus @default(SENT)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([triggerKey, channel])
  @@map("notification_logs")
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  SMS
}

enum NotificationLogStatus {
  SENT
  DELIVERED
  FAILED
}

// ============================================================================
// QUESTIONÁRIO AMBIENTAL (score ambientado — decisões B4/B5)
// ============================================================================

/// Pergunta da anamnese ambiental, ligada a um grupo genético.
///
/// O escore ambiental é calculado por CATEGORIA: cada pergunta influencia o
/// grupo genético que ela mede (`categorySlug`), com um `weight` dentro dele.
/// Assim o laboratório adiciona, remove e repesa perguntas por dados — sem
/// deploy — como o Dr. Câmara pediu (decisão B5). A matemática de combinação
/// (aditiva na performance, multiplicativa na nutrigenética) vive na
/// ScoringStrategy e não muda por causa das perguntas.
model EnvironmentalQuestion {
  id String @id @default(uuid()) @db.Char(36)

  /// Painel a que a pergunta pertence: 'nutrigenetics' ou 'performance'.
  panelSlug String @db.VarChar(64)
  /// Grupo genético (categoria) que a resposta influencia — o slug real da
  /// categoria do painel (ex.: 'metabolismo_energetico', 'forca_potencia').
  categorySlug String @db.VarChar(80)

  /// Checkpoint a que a pergunta pertence. Null = vale para todos, que é como o
  /// questionário nasceu (Q0–Q4 serviam o mesmo conjunto) e continua sendo o
  /// padrão do que o laboratório cria pelo admin. A especificação do cliente
  /// pede 24 perguntas POR checkpoint (12 fixas repetidas + 12 que mudam de
  /// foco), então as 120 perguntas reais vêm com o checkpoint preenchido.
  checkpoint Checkpoint?

  text String @db.VarChar(400)
  /// Peso da pergunta dentro da categoria, na média ponderada.
  weight Float @default(1)
  order  Int   @default(0)
  active Boolean @default(true)

  options EnvironmentalOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([panelSlug, categorySlug])
  @@index([panelSlug, checkpoint])
  @@map("environmental_questions")
}

/// Opção de resposta de uma pergunta ambiental.
model EnvironmentalOption {
  id         String                @id @default(uuid()) @db.Char(36)
  questionId String                @db.Char(36)
  question   EnvironmentalQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  label String @db.VarChar(200)
  /// Qualidade do hábito nesta resposta: 0 (pior) a 100 (melhor). A média
  /// ponderada por categoria vira 0–1 e é mapeada para a escala da estratégia.
  ///
  /// Float, e não Int, porque a pontuação da spec é por POSIÇÃO da opção e a 2ª
  /// e a 3ª valem 66,7 e 33,3 — arredondar para inteiro deslocaria o ambiental
  /// de cada bloco.
  points Float
  order  Int @default(0)

  @@index([questionId])
  @@map("environmental_options")
}
